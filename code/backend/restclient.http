Authorization: Bearer {{token}}


### ==========================================
### 写作交流 (Writing Community)
### ==========================================

### 获取写作作品列表
GET {{baseUrl}}/writing/works?page=1&page_size=10
Authorization: Bearer {{token}}

### 创建写作作品
POST {{baseUrl}}/writing/works
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "致青春的一封信",
  "content": "亲爱的青春，感谢你赋予我勇气和梦想。在那些最美好的日子里，我们一起笑过、哭过、疯狂过...",
  "category": "prose",
  "tags": ["青春", "回忆", "成长", "感悟"]
}

### 获取写作作品详情
GET {{baseUrl}}/writing/works/{{workId}}
Authorization: Bearer {{token}}

### 更新写作作品
PUT {{baseUrl}}/writing/works/{{workId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "致青春的一封信（修订版）",
  "content": "亲爱的青春，感谢你赋予我勇气和梦想。在那些最美好的日子里，我们一起笑过、哭过、疯狂过。现在回想起来，每一个瞬间都是如此珍贵...",
  "category": "prose",
  "tags": ["青春", "回忆", "成长", "感悟", "人生"]
}

### 删除写作作品
DELETE {{baseUrl}}/writing/works/{{workId}}
Authorization: Bearer {{token}}

### 获取作品评论列表
GET {{baseUrl}}/writing/works/{{workId}}/comments?page=1&page_size=20
Authorization: Bearer {{token}}

### 创建作品评论
POST {{baseUrl}}/writing/works/{{workId}}/comments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "work_id": "{{workId}}",
  "parent_id": null,
  "content": "写得真好！深有同感，青春真的是最美好的时光。"
}

### 回复评论
POST {{baseUrl}}/writing/works/{{workId}}/comments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "work_id": "{{workId}}",
  "parent_id": "00000000-0000-0000-0000-000000000000",
  "content": "谢谢你的认同，让我们珍惜当下吧！"
}

### 点赞作品
POST {{baseUrl}}/writing/works/{{workId}}/like
Authorization: Bearer {{token}}


