{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT DISTINCT ON (gs.user_id)\n            gs.score,\n            gs.time_spent,\n            u.id as user_id,\n            u.username,\n            u.nickname as \"nickname?\",\n            u.avatar as \"avatar?\"\n        FROM game_scores gs\n        JOIN users u ON gs.user_id = u.id\n        WHERE gs.game_type = $1 AND gs.level = $2\n        ORDER BY gs.user_id, gs.score DESC, gs.time_spent ASC\n        ",
