  "query": "\n        SELECT \n            l.id,\n            l.title,\n            l.content,\n            l.to_name,\n            l.from_name,\n            COALESCE(l.is_read, false) as \"is_read!\",\n            l.created_at,\n            l.user_id as from_user_id,\n            l.to_user_id\n        FROM love_letters l\n        WHERE l.id = $1\n        ",
